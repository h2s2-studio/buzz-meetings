{
  "name": "h2s2-buzz-meetings",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "cargo run --locked -p buzz-meetings-server",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "test:browser": "playwright test",
    "build": "tsc && node scripts/build.mjs",
    "check:build": "tsc && node scripts/build.mjs --check",
    "test:media": "node scripts/test-media.mjs"
  },
  "dependencies": {
    "livekit-client": "2.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
